{%- comment -%} Renkli Mozaik: koleksiyon kartları. Her kart görsel, başlık ve bağlantı alır. {%- endcomment -%}
<div class="rm-vitrin color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="rm-vitrin__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="rm-vitrin__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="rm-vitrin__item" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="rm-vitrin__link">
            <span class="rm-vitrin__imgwrap">
              {%- if block.settings.image != blank -%}
                {%- assign rm_alt = block.settings.image.alt | default: block.settings.title -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 100vw', class: 'rm-vitrin__img', alt: rm_alt }}
              {%- elsif block.settings.fallback_asset != blank -%}
                <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.title | escape }}" class="rm-vitrin__img" loading="lazy" width="1080" height="1080">
              {%- endif -%}
            </span>
            <span class="rm-vitrin__title h3">{{ block.settings.title | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Renkli Mozaik: Koleksiyon kartları",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Koleksiyonlar" },
    { "type": "select", "id": "heading_size", "label": "Başlık boyutu", "default": "h1",
      "options": [ { "value": "h2", "label": "Küçük" }, { "value": "h1", "label": "Orta" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "kart",
      "name": "Kart",
      "settings": [
        { "type": "text", "id": "title", "label": "Başlık", "default": "Koleksiyon" },
        { "type": "url", "id": "link", "label": "Bağlantı" },
        { "type": "image_picker", "id": "image", "label": "Görsel (seçilmezse hazır görsel gösterilir)" },
        { "type": "text", "id": "fallback_asset", "label": "Hazır görsel dosya adı" }
      ]
    }
  ],
  "presets": [
    { "name": "Renkli Mozaik: Koleksiyon kartları",
      "blocks": [ { "type": "kart" }, { "type": "kart" }, { "type": "kart" } ] }
  ]
}
{% endschema %}
